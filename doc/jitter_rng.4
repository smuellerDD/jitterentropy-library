.BR jitter_rng (1),
.BR jent_entropy_collector_alloc (3),
.BR jent_selftest (3),
.BR jent_status (3),
.BR jitterentropy (3),
.BR jitterentropy-kernel (3),
.BR random (4),
.BR modprobe (8)
