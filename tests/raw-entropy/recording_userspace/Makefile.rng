# Compile Noise Source as user space application

CC ?= cc
# "override" on every append, as the top level Makefile has: a plain += is
# ignored for a variable set on the make command line, so "make CFLAGS=-g"
# used to drop the include paths, -O0, the defines and the hardening. And once
# a variable has an override, make ignores every later assignment to it that
# lacks one, so all of them carry it.
override CFLAGS +=-Wextra -Wall -pedantic -fPIC -O0
#Hardening
override CFLAGS +=-fwrapv --param ssp-buffer-size=4
ifneq (Darwin,$(shell uname))
override LDFLAGS +=-Wl,-z,relro,-z,now
endif

# Enable internal timer support
override CFLAGS += -DJENT_CONF_ENABLE_INTERNAL_TIMER

GCCVERSIONFORMAT := $(shell echo `$(CC) -dumpversion | sed 's/\./\n/g' | wc -l`)
ifeq "$(GCCVERSIONFORMAT)" "3"
  GCC_GTEQ_490 := $(shell expr `$(CC) -dumpversion | sed -e 's/\.\([0-9][0-9]\)/\1/g' -e 's/\.\([0-9]\)/0\1/g' -e 's/^[0-9]\{3,4\}$$/&00/'` \>= 40900)
else
  GCC_GTEQ_490 := $(shell expr `$(CC) -dumpfullversion | sed -e 's/\.\([0-9][0-9]\)/\1/g' -e 's/\.\([0-9]\)/0\1/g' -e 's/^[0-9]\{3,4\}$$/&00/'` \>= 40900)
endif

ifeq "$(GCC_GTEQ_490)" "1"
  override CFLAGS += -fstack-protector-strong
else
  override CFLAGS += -fstack-protector-all
endif

JENT_DIR := jitterentropy
JENT_SRCS := $(wildcard $(JENT_DIR)/src/*.c) $(wildcard $(JENT_DIR)/arch/*.c)

NAME := jitterentropy-rng

# Compile all objects into a local directory. Emitting them next to the
# library sources (through the jitterentropy symlink) would leave objects
# built with this tool's flags inside src/ and arch/, which the library's
# own Makefile then silently picks up via VPATH - e.g. linking a
# libjitterentropy without JENT_CONF_ENABLE_INTERNAL_TIMER support.
OBJDIR := obj-rng
C_SRCS := $(JENT_SRCS) jitterentropy-rng.c
OBJS := $(addprefix $(OBJDIR)/,$(notdir $(C_SRCS:.c=.o)))

vpath %.c $(JENT_DIR)/src $(JENT_DIR)/arch

# $(JENT_DIR)/tests is for jitterentropy-memlock.h, shared with the unit tests.
INCLUDE_DIRS := $(JENT_DIR) $(JENT_DIR)/src $(JENT_DIR)/tests
LIBRARY_DIRS :=
# librt is a separate library only on Linux (glibc before 2.17) and Solaris;
# elsewhere the clock functions live in libc, and OpenBSD has no librt at
# all. Same rule as the top level Makefile.
ifneq (,$(filter $(shell uname),Linux SunOS))
LIBRARIES := rt pthread
else
LIBRARIES := pthread
endif

override CFLAGS += $(foreach includedir,$(INCLUDE_DIRS),-I$(includedir))
override LDFLAGS += $(foreach librarydir,$(LIBRARY_DIRS),-L$(librarydir))
override LDFLAGS += $(foreach library,$(LIBRARIES),-l$(library))

.PHONY: all clean distclean

all: $(NAME)

$(NAME): $(OBJS)
	$(CC) $(OBJS) -o $(NAME) $(LDFLAGS)

$(OBJDIR)/%.o: %.c | $(OBJDIR)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $<

$(OBJDIR):
	mkdir -p $(OBJDIR)

clean:
	@- $(RM) $(NAME)
	@- $(RM) -r $(OBJDIR)

distclean: clean
