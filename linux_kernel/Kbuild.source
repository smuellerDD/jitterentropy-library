# Linux kernel build system: source code compilation

############################## Auto-Configuration ##############################
#

# The option JENT_CONF_ENABLE_INTERNAL_TIMER must not be set as there is no
# in-kernel support for a timer thread
#
# Include paths are expressed relative to $(jent_srcdir), the source directory
# of this Kbuild (i.e. linux_kernel/), set in Kbuild:
#   $(jent_srcdir)        -> linux_kernel/  (kernel interface headers)
#   $(jent_srcdir)/..     -> project root   (jitterentropy.h, arch/*.h)
#   $(jent_srcdir)/../src -> src/           (library internal headers)
#
# The kernel interfaces get no src/: they use the library through
# jitterentropy.h alone, and the test interface the recording library's
# jitterentropy-record.h.
jitter_rng_c_args = -DLINUX_KERNEL					       \
		    -I$(jent_srcdir) -I$(jent_srcdir)/..
jitter_rng_lib_c_args = $(jitter_rng_c_args) -I$(jent_srcdir)/../src
jent_recorddir = tests/raw-entropy/recording_library

# Built in tree, crypto/Makefile enters this directory through
# "obj-$(CONFIG_CRYPTO_JITTERENTROPY) += jitterentropy-library/linux_kernel/"
# (see README.md, "Build in Tree"). With CONFIG_CRYPTO_JITTERENTROPY=m that
# enters it only for modules, where an obj-y would build nothing, and with =y
# an obj-m would leave vmlinux without the Jitter RNG the configuration asks
# for there.
# So the kernel configuration decides there and CONFIG_EXTERNAL_JITTERENTROPY
# follows it, whatever Kbuild.config says. An external module build (M=,
# DKMS; KBUILD_EXTMOD set) keeps the Kbuild.config value.
ifeq ($(KBUILD_EXTMOD),)
ifneq ($(filter y m,$(CONFIG_CRYPTO_JITTERENTROPY)),)
CONFIG_EXTERNAL_JITTERENTROPY := $(CONFIG_CRYPTO_JITTERENTROPY)
endif
endif

# The interface options are boolean: 'y' enables, anything else (unset, empty,
# 'n') disables. This allows overriding the Kbuild.config defaults from the
# make command line, e.g. "make CONFIG_EXTERNAL_JITTERENTROPY_HWRNG=n".
ifeq ($(CONFIG_EXTERNAL_JITTERENTROPY_TESTINTERFACE),y)
jitter_rng_c_args += -DCONFIG_EXTERNAL_JITTERENTROPY_TESTINTERFACE
endif

# The crypto API interface only against a kernel with the RNG algorithm type
# (crypto_register_rng() lives in crypto/rng.c, CONFIG_CRYPTO_RNG2), for the
# reason and with the built-in rule of the hwrng interface below.
ifeq ($(CONFIG_CRYPTO_RNG2),y)
jent_kcapi := $(CONFIG_EXTERNAL_JITTERENTROPY_KCAPI)
else ifeq ($(CONFIG_CRYPTO_RNG2)$(CONFIG_EXTERNAL_JITTERENTROPY),mm)
jent_kcapi := $(CONFIG_EXTERNAL_JITTERENTROPY_KCAPI)
endif

ifeq ($(jent_kcapi),y)
jitter_rng_c_args += -DCONFIG_EXTERNAL_JITTERENTROPY_KCAPI
endif

ifeq ($(CONFIG_EXTERNAL_JITTERENTROPY_CHARDEV),y)
jitter_rng_c_args += -DCONFIG_EXTERNAL_JITTERENTROPY_CHARDEV
endif

# hwrng only against a kernel with hw_random: <linux/hw_random.h> has no stubs,
# and a DKMS rebuild on such a kernel must not fail on the enabled default.
# Built into vmlinux it needs hw_random built in too, not rng-core.ko.
ifeq ($(CONFIG_HW_RANDOM),y)
jent_hwrng := $(CONFIG_EXTERNAL_JITTERENTROPY_HWRNG)
else ifeq ($(CONFIG_HW_RANDOM)$(CONFIG_EXTERNAL_JITTERENTROPY),mm)
jent_hwrng := $(CONFIG_EXTERNAL_JITTERENTROPY_HWRNG)
endif

ifeq ($(jent_hwrng),y)
jitter_rng_c_args += -DCONFIG_EXTERNAL_JITTERENTROPY_HWRNG
endif

ifeq ($(CONFIG_BUILTIN_JITTERENTROPY),y)
jitter_rng_c_args += -DCONFIG_BUILTIN_JITTERENTROPY
endif

################################# Compilation ##################################

obj-$(CONFIG_EXTERNAL_JITTERENTROPY)  := jitter_rng.o

jitter_rng-y += ../src/jitterentropy-base.o				       \
		../src/jitterentropy-gcd.o				       \
		../src/jitterentropy-health.o				       \
		../src/jitterentropy-noise.o				       \
		../src/jitterentropy-sha3.o				       \
		../src/jitterentropy-status.o				       \
		../src/jitterentropy-timer.o				       \
		../src/jitterentropy-uuid.o				       \
		../arch/jitterentropy-arch-atomic.o			       \
		../arch/jitterentropy-arch-memory.o			       \
		../arch/jitterentropy-arch-timer.o			       \
		../arch/jitterentropy-arch-sched.o			       \
		../arch/jitterentropy-arch-cache.o			       \
		../arch/jitterentropy-arch-fips.o			       \
		../arch/jitterentropy-arch-ncpu.o			       \
		../arch/jitterentropy-arch-random.o			       \
		jitterentropy_mod.o					       \
		jitterentropy_ioctl.o					       \
		jitterentropy_proc.o					       \
		jitterentropy_selftest.o				       \
		jitterentropy_status.o

jitter_rng_c_args_zero = -O0 $(jitter_rng_lib_c_args)

CFLAGS_../src/jitterentropy-base.o = $(jitter_rng_c_args_zero)
CFLAGS_../src/jitterentropy-gcd.o = $(jitter_rng_c_args_zero)
CFLAGS_../src/jitterentropy-health.o = $(jitter_rng_c_args_zero)
CFLAGS_../src/jitterentropy-noise.o = $(jitter_rng_c_args_zero)
CFLAGS_../src/jitterentropy-status.o = $(jitter_rng_lib_c_args)
# The UUID is formatting, not measurement: it needs no -O0.
CFLAGS_../src/jitterentropy-uuid.o = $(jitter_rng_lib_c_args)
CFLAGS_../src/jitterentropy-sha3.o = $(jitter_rng_c_args_zero)
CFLAGS_../src/jitterentropy-timer.o = $(jitter_rng_c_args_zero)
CFLAGS_../arch/jitterentropy-arch-atomic.o = $(jitter_rng_lib_c_args)
CFLAGS_../arch/jitterentropy-arch-memory.o = $(jitter_rng_lib_c_args)
# Deliberately not $(jitter_rng_c_args_zero), unlike the entropy core above.
# On architectures without a counter instruction this object reads the clock
# through <linux/timex.h>, and kernel headers are only meant to build
# optimized. The -O0 requirement covers the measured loops in the entropy
# core, not the counter read, so this costs a call per timestamp and nothing
# else.
CFLAGS_../arch/jitterentropy-arch-timer.o = $(jitter_rng_lib_c_args)
CFLAGS_../arch/jitterentropy-arch-sched.o = $(jitter_rng_lib_c_args)
CFLAGS_../arch/jitterentropy-arch-cache.o = $(jitter_rng_lib_c_args)
CFLAGS_../arch/jitterentropy-arch-fips.o = $(jitter_rng_lib_c_args)
CFLAGS_../arch/jitterentropy-arch-ncpu.o = $(jitter_rng_lib_c_args)
CFLAGS_../arch/jitterentropy-arch-random.o = $(jitter_rng_lib_c_args)
CFLAGS_jitterentropy_mod.o = $(jitter_rng_c_args)
CFLAGS_jitterentropy_ioctl.o = $(jitter_rng_c_args)
CFLAGS_jitterentropy_proc.o = $(jitter_rng_c_args)
CFLAGS_jitterentropy_selftest.o = $(jitter_rng_c_args)
CFLAGS_jitterentropy_status.o = $(jitter_rng_c_args)

################### Kernel Crypto API Interface Compilation ####################

jitter_rng-$(jent_kcapi)						       \
	+= jitterentropy_kcapi.o

CFLAGS_jitterentropy_kcapi.o = $(jitter_rng_c_args)

######################### Character Device Compilation #########################

jitter_rng-$(CONFIG_EXTERNAL_JITTERENTROPY_CHARDEV)			       \
	+= jitterentropy_chardev.o

CFLAGS_jitterentropy_chardev.o = $(jitter_rng_c_args)

############################# HW RNG Compilation ###############################

jitter_rng-$(jent_hwrng)						       \
	+= jitterentropy_hwrng.o

CFLAGS_jitterentropy_hwrng.o = $(jitter_rng_c_args)

############################ Test Code Compilation #############################

# The recording without a file of the recording library, which the test
# interface records through. No -O0: it runs between the measurements, not in
# them, as the test interface's own loop does.
jitter_rng-$(CONFIG_EXTERNAL_JITTERENTROPY_TESTINTERFACE)		       \
	+= jitterentropy_testing.o					       \
	   ../$(jent_recorddir)/jitterentropy-record-session.o

CFLAGS_jitterentropy_testing.o = $(jitter_rng_c_args)			       \
				 -I$(jent_srcdir)/../$(jent_recorddir)
CFLAGS_../$(jent_recorddir)/jitterentropy-record-session.o =		       \
	$(jitter_rng_lib_c_args)
