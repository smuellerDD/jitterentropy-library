#!/bin/ksh
#
# Seeds the kernel RNG from the Jitter RNG at boot and every ten minutes
# after. Enable with
#
#   rcctl enable jitterentropy_rngd
#   rcctl set jitterentropy_rngd flags ...	# further options
#
# rc_bg detaches it. The options that takes are part of daemon: the flags of
# rcctl replace daemon_flags, and with -F gone would detach it twice.

daemon="@PATH@/jitterentropy-rngd -F --syslog"

. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

rc_cmd $1
